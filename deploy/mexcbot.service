[Unit]
Description=MEXC Fair Scanner Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mexcbot
Group=mexcbot
WorkingDirectory=/opt/mexcbot

# Secrets and configuration are stored in this file (chmod 600, owned by mexcbot).
# Required variables:
#   BOT_TOKEN=<your Telegram bot token>
#   API_BASE_URL=http://127.0.0.1:8000  (loopback — bot and site are on the same server)
# Optional variables:
#   LOG_LEVEL=INFO          (set to DEBUG for verbose output)
#   REQUEST_TIMEOUT=5       (subscription API HTTP timeout in seconds)
EnvironmentFile=/opt/mexcbot/.env

ExecStart=/opt/mexcbot/venv/bin/python mexc_fair_scanner.py

# Automatically restart the bot if it crashes
Restart=on-failure
RestartSec=10

# Write logs to systemd journal (view with: journalctl -u mexcbot -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mexcbot

[Install]
WantedBy=multi-user.target
